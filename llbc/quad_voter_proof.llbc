it_refs":[]}}}},{"clause_id":7,"span":{"data":{"file_id":3,"beg":{"line":887,"col":77},"end":{"line":887,"col":81}},"generated_from_span":null},"origin":{"TraitItem":0},"trait_":{"regions":[],"skip_binder":{"id":11,"generics":{"regions":[],"types":[{"Deduplicated":1817}],"const_generics":[],"trait_refs":[]}}}},{"clause_id":8,"span":{"data":{"file_id":3,"beg":{"line":887,"col":84},"end":{"line":887,"col":89}},"generated_from_span":null},"origin":{"TraitItem":0},"trait_":{"regions":[],"skip_binder":{"id":12,"generics":{"regions":[],"types":[{"Deduplicated":1817}],"const_generics":[],"trait_refs":[]}}}}],"consts":[],"types":[{"params":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"Discriminant","attr_info":{"attributes":[{"DocComment":" The type of the discriminant, which must satisfy the trait"},{"DocComment":" bounds required by `mem::Discriminant`."}],"inline":null,"rename":null,"public":false},"default":null,"implied_clauses":[]},"kind":{"TraitType":[7,0]}}],"methods":[],"vtable":null},{"def_id":8,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]}],"span":{"data":{"file_id":8,"beg":{"line":1053,"col":0},"end":{"line":1053,"col":29}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" `?` formatting."},{"DocComment":""},{"DocComment":" `Debug` should format the output in a programmer-facing, debugging context."},{"DocComment":""},{"DocComment":" Generally speaking, you should just `derive` a `Debug` implementation."},{"DocComment":""},{"DocComment":" When used with the alternate format specifier `#?`, the output is pretty-printed."},{"DocComment":""},{"DocComment":" For more information on formatters, see [the module-level documentation][module]."},{"DocComment":""},{"DocComment":" [module]: ../../std/fmt/index.html"},{"DocComment":""},{"DocComment":" This trait can be used with `#[derive]` if all fields implement `Debug`. When"},{"DocComment":" `derive`d for structs, it will use the name of the `struct`, then `{`, then a"},{"DocComment":" comma-separated list of each field's name and `Debug` value, then `}`. For"},{"DocComment":" `enum`s, it will use the name of the variant and, if applicable, `(`, then the"},{"DocComment":" `Debug` values of the fields, then `)`."},{"DocComment":""},{"DocComment":" # Stability"},{"DocComment":""},{"DocComment":" Derived `Debug` formats are not stable, and so may change with future Rust"},{"DocComment":" versions. Additionally, `Debug` implementations of types provided by the"},{"DocComment":" standard library (`std`, `core`, `alloc`, etc.) are not stable, and"},{"DocComment":" may also change with future Rust versions."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" Deriving an implementation:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Manually implementing:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_struct(\"Point\")"},{"DocComment":"          .field(\"x\", &self.x)"},{"DocComment":"          .field(\"y\", &self.y)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" assert_eq!("},{"DocComment":"     format!(\"The origin is: {origin:?}\"),"},{"DocComment":"     \"The origin is: Point { x: 0, y: 0 }\","},{"DocComment":" );"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" There are a number of helper methods on the [`Formatter`] struct to help you with manual"},{"DocComment":" implementations, such as [`debug_struct`]."},{"DocComment":""},{"DocComment":" [`debug_struct`]: Formatter::debug_struct"},{"DocComment":""},{"DocComment":" Types that do not wish to use the standard suite of debug representations"},{"DocComment":" provided by the `Formatter` trait (`debug_struct`, `debug_tuple`,"},{"DocComment":" `debug_list`, `debug_set`, `debug_map`) can do something totally custom by"},{"DocComment":" manually writing an arbitrary representation to the `Formatter`."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" # use std::fmt;"},{"DocComment":" # struct Point {"},{"DocComment":" #     x: i32,"},{"DocComment":" #     y: i32,"},{"DocComment":" # }"},{"DocComment":" #"},{"DocComment":" impl fmt::Debug for Point {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         write!(f, \"Point [{} {}]\", self.x, self.y)"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" `Debug` implementations using either `derive` or the debug builder API"},{"DocComment":" on [`Formatter`] support pretty-printing using the alternate flag: `{:#?}`."},{"DocComment":""},{"DocComment":" Pretty-printing with `#?`:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Debug)]"},{"DocComment":" struct Point {"},{"DocComment":"     x: i32,"},{"DocComment":"     y: i32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let origin = Point { x: 0, y: 0 };"},{"DocComment":""},{"DocComment":" let expected = \"The origin is: Point {"},{"DocComment":"     x: 0,"},{"DocComment":"     y: 0,"},{"DocComment":" }\";"},{"DocComment":" assert_eq!(format!(\"The origin is: {origin:#?}\"), expected);"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Debug"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"},{"index":2,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"fmt","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["fmt",0]},{"Ident":["Debug",0]},{"Ident":["fmt",0]}],"span":{"data":{"file_id":8,"beg":{"line":1084,"col":4},"end":{"line":1084,"col":51}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":"Formats the value using the given formatter.\n\n# Errors\n\nThis function should return [`Err`] if, and only if, the provided [`Formatter`] returns [`Err`].\nString formatting is considered an infallible operation; this function only\nreturns a [`Result`] because writing to the underlying stream might fail and it must\nprovide a way to propagate the fact that an error has occurred back up the stack.\n"},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::fmt;"},{"DocComment":""},{"DocComment":" struct Position {"},{"DocComment":"     longitude: f32,"},{"DocComment":"     latitude: f32,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl fmt::Debug for Position {"},{"DocComment":"     fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {"},{"DocComment":"         f.debug_tuple(\"\")"},{"DocComment":"          .field(&self.longitude)"},{"DocComment":"          .field(&self.latitude)"},{"DocComment":"          .finish()"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" let position = Position { longitude: 1.987, latitude: 2.983 };"},{"DocComment":" assert_eq!(format!(\"{position:?}\"), \"(1.987, 2.983)\");"},{"DocComment":""},{"DocComment":" assert_eq!(format!(\"{position:#?}\"), \"("},{"DocComment":"     1.987,"},{"DocComment":"     2.983,"},{"DocComment":" )\");"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1812},{"HashConsedValue":[1819,{"Ref":[{"Var":{"Bound":[0,1]}},{"HashConsedValue":[1818,{"Adt":{"id":{"Adt":6},"generics":{"regions":[{"Var":{"Bound":[0,2]}}],"types":[],"const_generics":[],"trait_refs":[]}}}]},"Mut"]}]}],"output":{"HashConsedValue":[1821,{"Adt":{"id":{"Adt":7},"generics":{"regions":[],"types":[{"Deduplicated":416},{"HashConsedValue":[1820,{"Adt":{"id":{"Adt":8},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}]}],"const_generics":[],"trait_refs":[]}}}]}},"default":null},"kind":{"TraitMethod":[8,0]}}],"vtable":{"id":{"Adt":5},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":9,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hash",0]}],"span":{"data":{"file_id":9,"beg":{"line":185,"col":0},"end":{"line":185,"col":36}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A hashable type."},{"DocComment":""},{"DocComment":" Types implementing `Hash` are able to be [`hash`]ed with an instance of"},{"DocComment":" [`Hasher`]."},{"DocComment":""},{"DocComment":" ## Implementing `Hash`"},{"DocComment":""},{"DocComment":" You can derive `Hash` with `#[derive(Hash)]` if all fields implement `Hash`."},{"DocComment":" The resulting hash will be the combination of the values from calling"},{"DocComment":" [`hash`] on each field."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" #[derive(Hash)]"},{"DocComment":" struct Rustacean {"},{"DocComment":"     name: String,"},{"DocComment":"     country: String,"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" If you need more control over how a value is hashed, you can of course"},{"DocComment":" implement the `Hash` trait yourself:"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{Hash, Hasher};"},{"DocComment":""},{"DocComment":" struct Person {"},{"DocComment":"     id: u32,"},{"DocComment":"     name: String,"},{"DocComment":"     phone: u64,"},{"DocComment":" }"},{"DocComment":""},{"DocComment":" impl Hash for Person {"},{"DocComment":"     fn hash<H: Hasher>(&self, state: &mut H) {"},{"DocComment":"         self.id.hash(state);"},{"DocComment":"         self.phone.hash(state);"},{"DocComment":"     }"},{"DocComment":" }"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" ## `Hash` and `Eq`"},{"DocComment":""},{"DocComment":" When implementing both `Hash` and [`Eq`], it is important that the following"},{"DocComment":" property holds:"},{"DocComment":""},{"DocComment":" ```text"},{"DocComment":" k1 == k2 -> hash(k1) == hash(k2)"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" In other words, if two keys are equal, their hashes must also be equal."},{"DocComment":" [`HashMap`] and [`HashSet`] both rely on this behavior."},{"DocComment":""},{"DocComment":" Thankfully, you won't need to worry about upholding this property when"},{"DocComment":" deriving both [`Eq`] and `Hash` with `#[derive(PartialEq, Eq, Hash)]`."},{"DocComment":""},{"DocComment":" Violating this property is a logic error. The behavior resulting from a logic error is not"},{"DocComment":" specified, but users of the trait must ensure that such logic errors do *not* result in"},{"DocComment":" undefined behavior. This means that `unsafe` code **must not** rely on the correctness of these"},{"DocComment":" methods."},{"DocComment":""},{"DocComment":" ## Prefix collisions"},{"DocComment":""},{"DocComment":" Implementations of `hash` should ensure that the data they"},{"DocComment":" pass to the `Hasher` are prefix-free. That is,"},{"DocComment":" values which are not equal should cause two different sequences of values to be written,"},{"DocComment":" and neither of the two sequences should be a prefix of the other."},{"DocComment":""},{"DocComment":" For example, the standard implementation of [`Hash` for `&str`][impl] passes an extra"},{"DocComment":" `0xFF` byte to the `Hasher` so that the values `(\"ab\", \"c\")` and `(\"a\","},{"DocComment":" \"bc\")` hash differently."},{"DocComment":""},{"DocComment":" ## Portability"},{"DocComment":""},{"DocComment":" Due to differences in endianness and type sizes, data fed by `Hash` to a `Hasher`"},{"DocComment":" should not be considered portable across platforms. Additionally the data passed by most"},{"DocComment":" standard library types should not be considered stable between compiler versions."},{"DocComment":""},{"DocComment":" This means tests shouldn't probe hard-coded hash values or data fed to a `Hasher` and"},{"DocComment":" instead should check consistency with `Eq`."},{"DocComment":""},{"DocComment":" Serialization formats intended to be portable between platforms or compiler versions should"},{"DocComment":" either avoid encoding hashes or only rely on `Hash` and `Hasher` implementations that"},{"DocComment":" provide additional guarantees."},{"DocComment":""},{"DocComment":" [`HashMap`]: ../../std/collections/struct.HashMap.html"},{"DocComment":" [`HashSet`]: ../../std/collections/struct.HashSet.html"},{"DocComment":" [`hash`]: Hash::hash"},{"DocComment":" [impl]: ../../std/primitive.str.html#impl-Hash-for-str"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Hash"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[{"index":0,"name":"H"}],"const_generics":[],"trait_clauses":[{"clause_id":0,"span":{"data":{"file_id":9,"beg":{"line":198,"col":15},"end":{"line":198,"col":21}},"generated_from_span":null},"origin":"WhereClauseOnFn","trait_":{"regions":[],"skip_binder":{"id":13,"generics":{"regions":[],"types":[{"HashConsedValue":[401,{"TypeVar":{"Bound":[1,0]}}]}],"const_generics":[],"trait_refs":[]}}}}],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"hash","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hash",0]},{"Ident":["hash",0]}],"span":{"data":{"file_id":9,"beg":{"line":198,"col":4},"end":{"line":198,"col":45}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Feeds this value into the given [`Hasher`]."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hash, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":" 7920.hash(&mut hasher);"},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1812},{"HashConsedValue":[1822,{"Ref":[{"Var":{"Bound":[0,1]}},{"HashConsedValue":[400,{"TypeVar":{"Bound":[0,0]}}]},"Mut"]}]}],"output":{"Deduplicated":416}},"default":null},"kind":{"TraitMethod":[9,0]}},null],"vtable":null},{"def_id":10,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Send",0]}],"span":{"data":{"file_id":3,"beg":{"line":92,"col":0},"end":{"line":92,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that can be transferred across thread boundaries."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines it's"},{"DocComment":" appropriate."},{"DocComment":""},{"DocComment":" An example of a non-`Send` type is the reference-counting pointer"},{"DocComment":" [`rc::Rc`][`Rc`]. If two threads attempt to clone [`Rc`]s that point to the same"},{"DocComment":" reference-counted value, they might try to update the reference count at the"},{"DocComment":" same time, which is [undefined behavior][ub] because [`Rc`] doesn't use atomic"},{"DocComment":" operations. Its cousin [`sync::Arc`][arc] does use atomic operations (incurring"},{"DocComment":" some overhead) and thus is `Send`."},{"DocComment":""},{"DocComment":" See [the Nomicon](../../nomicon/send-and-sync.html) and the [`Sync`] trait for more details."},{"DocComment":""},{"DocComment":" [`Rc`]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"Send"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":9},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":11,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Sync",0]}],"span":{"data":{"file_id":3,"beg":{"line":657,"col":0},"end":{"line":657,"col":26}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types for which it is safe to share references between threads."},{"DocComment":""},{"DocComment":" This trait is automatically implemented when the compiler determines"},{"DocComment":" it's appropriate."},{"DocComment":""},{"DocComment":" The precise definition is: a type `T` is [`Sync`] if and only if `&T` is"},{"DocComment":" [`Send`]. In other words, if there is no possibility of"},{"DocComment":" [undefined behavior][ub] (including data races) when passing"},{"DocComment":" `&T` references between threads."},{"DocComment":""},{"DocComment":" As one would expect, primitive types like [`u8`] and [`f64`]"},{"DocComment":" are all [`Sync`], and so are simple aggregate types containing them,"},{"DocComment":" like tuples, structs and enums. More examples of basic [`Sync`]"},{"DocComment":" types include \"immutable\" types like `&T`, and those with simple"},{"DocComment":" inherited mutability, such as [`Box<T>`][box], [`Vec<T>`][vec] and"},{"DocComment":" most other collection types. (Generic parameters need to be [`Sync`]"},{"DocComment":" for their container to be [`Sync`].)"},{"DocComment":""},{"DocComment":" A somewhat surprising consequence of the definition is that `&mut T`"},{"DocComment":" is `Sync` (if `T` is `Sync`) even though it seems like that might"},{"DocComment":" provide unsynchronized mutation. The trick is that a mutable"},{"DocComment":" reference behind a shared reference (that is, `& &mut T`)"},{"DocComment":" becomes read-only, as if it were a `& &T`. Hence there is no risk"},{"DocComment":" of a data race."},{"DocComment":""},{"DocComment":" A shorter overview of how [`Sync`] and [`Send`] relate to referencing:"},{"DocComment":" * `&T` is [`Send`] if and only if `T` is [`Sync`]"},{"DocComment":" * `&mut T` is [`Send`] if and only if `T` is [`Send`]"},{"DocComment":" * `&T` and `&mut T` are [`Sync`] if and only if `T` is [`Sync`]"},{"DocComment":""},{"DocComment":" Types that are not `Sync` are those that have \"interior"},{"DocComment":" mutability\" in a non-thread-safe form, such as [`Cell`][cell]"},{"DocComment":" and [`RefCell`][refcell]. These types allow for mutation of"},{"DocComment":" their contents even through an immutable, shared reference. For"},{"DocComment":" example the `set` method on [`Cell<T>`][cell] takes `&self`, so it requires"},{"DocComment":" only a shared reference [`&Cell<T>`][cell]. The method performs no"},{"DocComment":" synchronization, thus [`Cell`][cell] cannot be `Sync`."},{"DocComment":""},{"DocComment":" Another example of a non-`Sync` type is the reference-counting"},{"DocComment":" pointer [`Rc`][rc]. Given any reference [`&Rc<T>`][rc], you can clone"},{"DocComment":" a new [`Rc<T>`][rc], modifying the reference counts in a non-atomic way."},{"DocComment":""},{"DocComment":" For cases when one does need thread-safe interior mutability,"},{"DocComment":" Rust provides [atomic data types], as well as explicit locking via"},{"DocComment":" [`sync::Mutex`][mutex] and [`sync::RwLock`][rwlock]. These types"},{"DocComment":" ensure that any mutation cannot cause data races, hence the types"},{"DocComment":" are `Sync`. Likewise, [`sync::Arc`][arc] provides a thread-safe"},{"DocComment":" analogue of [`Rc`][rc]."},{"DocComment":""},{"DocComment":" Any types with interior mutability must also use the"},{"DocComment":" [`cell::UnsafeCell`][unsafecell] wrapper around the value(s) which"},{"DocComment":" can be mutated through a shared reference. Failing to doing this is"},{"DocComment":" [undefined behavior][ub]. For example, [`transmute`][transmute]-ing"},{"DocComment":" from `&T` to `&mut T` is invalid."},{"DocComment":""},{"DocComment":" See [the Nomicon][nomicon-send-and-sync] for more details about `Sync`."},{"DocComment":""},{"DocComment":" [box]: ../../std/boxed/struct.Box.html"},{"DocComment":" [vec]: ../../std/vec/struct.Vec.html"},{"DocComment":" [cell]: crate::cell::Cell"},{"DocComment":" [refcell]: crate::cell::RefCell"},{"DocComment":" [rc]: ../../std/rc/struct.Rc.html"},{"DocComment":" [arc]: ../../std/sync/struct.Arc.html"},{"DocComment":" [atomic data types]: crate::sync::atomic"},{"DocComment":" [mutex]: ../../std/sync/struct.Mutex.html"},{"DocComment":" [rwlock]: ../../std/sync/struct.RwLock.html"},{"DocComment":" [unsafecell]: crate::cell::UnsafeCell"},{"DocComment":" [ub]: ../../reference/behavior-considered-undefined.html"},{"DocComment":" [transmute]: crate::mem::transmute"},{"DocComment":" [nomicon-send-and-sync]: ../../nomicon/send-and-sync.html"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"sync"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":10},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":12,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["marker",0]},{"Ident":["Unpin",0]}],"span":{"data":{"file_id":3,"beg":{"line":1014,"col":0},"end":{"line":1014,"col":20}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Types that do not require any pinning guarantees."},{"DocComment":""},{"DocComment":" For information on what \"pinning\" is, see the [`pin` module] documentation."},{"DocComment":""},{"DocComment":" Implementing the `Unpin` trait for `T` expresses the fact that `T` is pinning-agnostic:"},{"DocComment":" it shall not expose nor rely on any pinning guarantees. This, in turn, means that a"},{"DocComment":" `Pin`-wrapped pointer to such a type can feature a *fully unrestricted* API."},{"DocComment":" In other words, if `T: Unpin`, a value of type `T` will *not* be bound by the invariants"},{"DocComment":" which pinning otherwise offers, even when \"pinned\" by a [`Pin<Ptr>`] pointing at it."},{"DocComment":" When a value of type `T` is pointed at by a [`Pin<Ptr>`], [`Pin`] will not restrict access"},{"DocComment":" to the pointee value like it normally would, thus allowing the user to do anything that they"},{"DocComment":" normally could with a non-[`Pin`]-wrapped `Ptr` to that value."},{"DocComment":""},{"DocComment":" The idea of this trait is to alleviate the reduced ergonomics of APIs that require the use"},{"DocComment":" of [`Pin`] for soundness for some types, but which also want to be used by other types that"},{"DocComment":" don't care about pinning. The prime example of such an API is [`Future::poll`]. There are many"},{"DocComment":" [`Future`] types that don't care about pinning. These futures can implement `Unpin` and"},{"DocComment":" therefore get around the pinning related restrictions in the API, while still allowing the"},{"DocComment":" subset of [`Future`]s which *do* require pinning to be implemented soundly."},{"DocComment":""},{"DocComment":" For more discussion on the consequences of [`Unpin`] within the wider scope of the pinning"},{"DocComment":" system, see the [section about `Unpin`] in the [`pin` module]."},{"DocComment":""},{"DocComment":" `Unpin` has no consequence at all for non-pinned data. In particular, [`mem::replace`] happily"},{"DocComment":" moves `!Unpin` data, which would be immovable when pinned ([`mem::replace`] works for any"},{"DocComment":" `&mut T`, not just when `T: Unpin`)."},{"DocComment":""},{"DocComment":" *However*, you cannot use [`mem::replace`] on `!Unpin` data which is *pinned* by being wrapped"},{"DocComment":" inside a [`Pin<Ptr>`] pointing at it. This is because you cannot (safely) use a"},{"DocComment":" [`Pin<Ptr>`] to get a `&mut T` to its pointee value, which you would need to call"},{"DocComment":" [`mem::replace`], and *that* is what makes this system work."},{"DocComment":""},{"DocComment":" So this, for example, can only be done on types implementing `Unpin`:"},{"DocComment":""},{"DocComment":" ```rust"},{"DocComment":" # #![allow(unused_must_use)]"},{"DocComment":" use std::mem;"},{"DocComment":" use std::pin::Pin;"},{"DocComment":""},{"DocComment":" let mut string = \"this\".to_string();"},{"DocComment":" let mut pinned_string = Pin::new(&mut string);"},{"DocComment":""},{"DocComment":" // We need a mutable reference to call `mem::replace`."},{"DocComment":" // We can obtain such a reference by (implicitly) invoking `Pin::deref_mut`,"},{"DocComment":" // but that is only possible because `String` implements `Unpin`."},{"DocComment":" mem::replace(&mut *pinned_string, \"other\".to_string());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" This trait is automatically implemented for almost every type. The compiler is free"},{"DocComment":" to take the conservative stance of marking types as [`Unpin`] so long as all of the types that"},{"DocComment":" compose its fields are also [`Unpin`]. This is because if a type implements [`Unpin`], then it"},{"DocComment":" is unsound for that type's implementation to rely on pinning-related guarantees for soundness,"},{"DocComment":" *even* when viewed through a \"pinning\" pointer! It is the responsibility of the implementor of"},{"DocComment":" a type that relies upon pinning for soundness to ensure that type is *not* marked as [`Unpin`]"},{"DocComment":" by adding [`PhantomPinned`] field. For more details, see the [`pin` module] docs."},{"DocComment":""},{"DocComment":" [`mem::replace`]: crate::mem::replace \"mem replace\""},{"DocComment":" [`Future`]: crate::future::Future \"Future\""},{"DocComment":" [`Future::poll`]: crate::future::Future::poll \"Future poll\""},{"DocComment":" [`Pin`]: crate::pin::Pin \"Pin\""},{"DocComment":" [`Pin<Ptr>`]: crate::pin::Pin \"Pin\""},{"DocComment":" [`pin` module]: crate::pin \"pin module\""},{"DocComment":" [section about `Unpin`]: crate::pin#unpin \"pin module docs about unpin\""},{"DocComment":" [`unsafe`]: ../../std/keyword.unsafe.html \"keyword unsafe\""}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":"unpin"},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[],"vtable":{"id":{"Adt":11},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}},{"def_id":13,"item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hasher",0]}],"span":{"data":{"file_id":9,"beg":{"line":312,"col":0},"end":{"line":312,"col":16}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" A trait for hashing an arbitrary stream of bytes."},{"DocComment":""},{"DocComment":" Instances of `Hasher` usually represent state that is changed while hashing"},{"DocComment":" data."},{"DocComment":""},{"DocComment":" `Hasher` provides a fairly basic interface for retrieving the generated hash"},{"DocComment":" (with [`finish`]), and writing integers as well as slices of bytes into an"},{"DocComment":" instance (with [`write`] and [`write_u8`] etc.). Most of the time, `Hasher`"},{"DocComment":" instances are used in conjunction with the [`Hash`] trait."},{"DocComment":""},{"DocComment":" This trait provides no guarantees about how the various `write_*` methods are"},{"DocComment":" defined and implementations of [`Hash`] should not assume that they work one"},{"DocComment":" way or another. You cannot assume, for example, that a [`write_u32`] call is"},{"DocComment":" equivalent to four calls of [`write_u8`].  Nor can you assume that adjacent"},{"DocComment":" `write` calls are merged, so it's possible, for example, that"},{"DocComment":" ```"},{"DocComment":" # fn foo(hasher: &mut impl std::hash::Hasher) {"},{"DocComment":" hasher.write(&[1, 2]);"},{"DocComment":" hasher.write(&[3, 4, 5, 6]);"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":" and"},{"DocComment":" ```"},{"DocComment":" # fn foo(hasher: &mut impl std::hash::Hasher) {"},{"DocComment":" hasher.write(&[1, 2, 3, 4]);"},{"DocComment":" hasher.write(&[5, 6]);"},{"DocComment":" # }"},{"DocComment":" ```"},{"DocComment":" end up producing different hashes."},{"DocComment":""},{"DocComment":" Thus to produce the same hash value, [`Hash`] implementations must ensure"},{"DocComment":" for equivalent items that exactly the same sequence of calls is made -- the"},{"DocComment":" same methods with the same parameters in the same order."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":""},{"DocComment":" hasher.write_u32(1989);"},{"DocComment":" hasher.write_u8(11);"},{"DocComment":" hasher.write_u8(9);"},{"DocComment":" hasher.write(b\"Huh?\");"},{"DocComment":""},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`finish`]: Hasher::finish"},{"DocComment":" [`write`]: Hasher::write"},{"DocComment":" [`write_u8`]: Hasher::write_u8"},{"DocComment":" [`write_u32`]: Hasher::write_u32"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"generics":{"regions":[],"types":[{"index":0,"name":"Self"}],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_clauses":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"finish","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hasher",0]},{"Ident":["finish",0]}],"span":{"data":{"file_id":9,"beg":{"line":334,"col":4},"end":{"line":334,"col":28}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Returns the hash value for the values written so far."},{"DocComment":""},{"DocComment":" Despite its name, the method does not reset the hasher’s internal"},{"DocComment":" state. Additional [`write`]s will continue from the current value."},{"DocComment":" If you need to start a fresh hash value, you will have to create"},{"DocComment":" a new hasher."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":" hasher.write(b\"Cool!\");"},{"DocComment":""},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" [`write`]: Hasher::write"}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1812}],"output":{"Deduplicated":366}},"default":null},"kind":{"TraitMethod":[13,0]}},{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"},{"index":1,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"name":"write","item_meta":{"name":[{"Ident":["core",0]},{"Ident":["hash",0]},{"Ident":["Hasher",0]},{"Ident":["write",0]}],"span":{"data":{"file_id":9,"beg":{"line":357,"col":4},"end":{"line":357,"col":38}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[{"DocComment":" Writes some data into this `Hasher`."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use std::hash::{DefaultHasher, Hasher};"},{"DocComment":""},{"DocComment":" let mut hasher = DefaultHasher::new();"},{"DocComment":" let data = [0x01, 0x23, 0x45, 0x67, 0x89, 0xab, 0xcd, 0xef];"},{"DocComment":""},{"DocComment":" hasher.write(&data);"},{"DocComment":""},{"DocComment":" println!(\"Hash is {:x}!\", hasher.finish());"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" # Note to Implementers"},{"DocComment":""},{"DocComment":" You generally should not do length-prefixing as part of implementing"},{"DocComment":" this method.  It's up to the [`Hash`] implementation to call"},{"DocComment":" [`Hasher::write_length_prefix`] before sequences that need it."}],"inline":null,"rename":null,"public":true},"is_local":false,"opacity":"Foreign","lang_item":null},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":1813},{"HashConsedValue":[1824,{"Ref":[{"Var":{"Bound":[0,1]}},{"HashConsedValue":[1823,{"Slice":{"Deduplicated":375}}]},"Shared"]}]}],"output":{"Deduplicated":416}},"default":null},"kind":{"TraitMethod":[13,1]}},null,null,null,null,null,null,null,null,null,null,null,null,null,null],"vtable":{"id":{"Adt":12},"generics":{"regions":[],"types":[],"const_generics":[],"trait_refs":[]}}}],"trait_impls":[null,{"def_id":1,"item_meta":{"name":[{"Ident":["quad_voter_proof",0]},{"Impl":{"Trait":1}}],"span":{"data":{"file_id":0,"beg":{"line":69,"col":9},"end":{"line":69,"col":14}},"generated_from_span":null},"source_text":null,"attr_info":{"attributes":[],"inline":null,"rename":null,"public":false},"is_local":true,"opacity":"Transparent","lang_item":null},"impl_trait":{"id":1,"generics":{"regions":[],"types":[{"Deduplicated":388}],"const_generics":[],"trait_refs":[]}},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"implied_trait_refs":[],"consts":[],"types":[],"methods":[{"params":{"regions":[{"index":0,"name":null,"mutability":"Unknown"}],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"skip_binder":{"id":5,"generics":{"regions":[{"Var":{"Bound":[0,0]}}],"types":[],"const_generics":[],"trait_refs":[]}},"kind":{"TraitMethod":[1,0]}},null],"vtable