]},{"span":{"data":{"file_id":0,"beg":{"line":281,"col":0},"end":{"line":281,"col":1}},"generated_from_span":null},"id":416,"kind":{"StorageDead":9},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":281,"col":0},"end":{"line":281,"col":1}},"generated_from_span":null},"id":417,"kind":{"StorageDead":7},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":281,"col":0},"end":{"line":281,"col":1}},"generated_from_span":null},"id":418,"kind":{"StorageDead":5},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":281,"col":0},"end":{"line":281,"col":1}},"generated_from_span":null},"id":419,"kind":{"StorageDead":3},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":281,"col":0},"end":{"line":281,"col":1}},"generated_from_span":null},"id":420,"kind":{"StorageDead":29},"comments_before":[]},{"span":{"data":{"file_id":0,"beg":{"line":281,"col":1},"end":{"line":281,"col":1}},"generated_from_span":null},"id":421,"kind":"Return","comments_before":[]}]},"comments":[[247,["w0 == w1 == w2 == w3 (eq12/eq13/eq23 follow from eq01/eq02/eq03","by transitivity, so they are not tested here)."]],[252,["{0,1,2} agree on w0; channel 3 differs."]],[258,["{0,1,3} agree on w0; channel 2 differs."]],[264,["{0,2,3} agree on w0; channel 1 differs."]],[270,["{1,2,3} agree on w1, w0 differs from all three of them."]],[279,["Every other combination: a 2-2 split, a 2-1-1 split, all four","different, or (for the six-flag tuple) a combination that real","`==` can never actually produce. All fall through to the same","no-command result."]]]}}},{"def_id":4,"item_meta":{"name":[{"Ident":["quad_voter_proof",0]},{"Ident":["step",0]}],"span":{"data":{"file_id":0,"beg":{"line":336,"col":0},"end":{"line":371,"col":1}},"generated_from_span":null},"source_text":"pub fn step(active: ActiveSet, words: [Word; 4]) -> StepResult {\n    let a0 = active[0];\n    let a1 = active[1];\n    let a2 = active[2];\n    let a3 = active[3];\n    match (a0, a1, a2, a3) {\n        (true, true, true, true) => quad_step(words, active),\n        (true, true, true, false) => triple_step(0, words[0], 1, words[1], 2, words[2], active),\n        (true, true, false, true) => triple_step(0, words[0], 1, words[1], 3, words[3], active),\n        (true, false, true, true) => triple_step(0, words[0], 2, words[2], 3, words[3], active),\n        (false, true, true, true) => triple_step(1, words[1], 2, words[2], 3, words[3], active),\n        (true, true, false, false) => pair_step(words[0], words[1], active),\n        (true, false, true, false) => pair_step(words[0], words[2], active),\n        (true, false, false, true) => pair_step(words[0], words[3], active),\n        (false, true, true, false) => pair_step(words[1], words[2], active),\n        (false, true, false, true) => pair_step(words[1], words[3], active),\n        (false, false, true, true) => pair_step(words[2], words[3], active),\n        (true, false, false, false) => StepResult::Agreed {\n            command: words[0],\n            active,\n        },\n        (false, true, false, false) => StepResult::Agreed {\n            command: words[1],\n            active,\n        },\n        (false, false, true, false) => StepResult::Agreed {\n            command: words[2],\n            active,\n        },\n        (false, false, false, true) => StepResult::Agreed {\n            command: words[3],\n            active,\n        },\n        (false, false, false, false) => StepResult::NoActiveChannels { active },\n    }\n}","attr_info":{"attributes":[{"DocComment":" One comparison-scheme step: given which channels are currently active"},{"DocComment":" and the command word each of the four channels produced this cycle,"},{"DocComment":" returns the chosen command (if any), which channel (if any) is switched"},{"DocComment":" off, and the active set to continue with."},{"DocComment":""},{"DocComment":" No loop, no recursion, no allocation, no `unsafe`; every input has a"},{"DocComment":" well-defined output ([`StepResult`] is never a panic — see `T1` in"},{"DocComment":" `reports/PROOF.md`)."},{"DocComment":""},{"DocComment":" # Examples"},{"DocComment":""},{"DocComment":" `StepResult` derives `Debug` only under `cfg(test)` (see the note on the"},{"DocComment":" type), so these examples match on the result instead of using"},{"DocComment":" `assert_eq!`, which would require `Debug` here too."},{"DocComment":""},{"DocComment":" ```"},{"DocComment":" use quad_voter_proof::{step, StepResult};"},{"DocComment":""},{"DocComment":" // All four channels agree: command 7, nobody switched off."},{"DocComment":" let result = step([true, true, true, true], [7, 7, 7, 7]);"},{"DocComment":" assert!(matches!("},{"DocComment":"     result,"},{"DocComment":"     StepResult::Agreed {"},{"DocComment":"         command: 7,"},{"DocComment":"         active: [true, true, true, true]"},{"DocComment":"     }"},{"DocComment":" ));"},{"DocComment":""},{"DocComment":" // Channel 2 disagrees with the other three: it is switched off."},{"DocComment":" let result = step([true, true, true, true], [7, 7, 9, 7]);"},{"DocComment":" assert!(matches!("},{"DocComment":"     result,"},{"DocComment":"     StepResult::Majority {"},{"DocComment":"         command: 7,"},{"DocComment":"         disabled: 2,"},{"DocComment":"         active: [true, true, false, true]"},{"DocComment":"     }"},{"DocComment":" ));"},{"DocComment":""},{"DocComment":" // A disagreeing pair: the source does not say what happens."},{"DocComment":" let result = step([true, false, false, true], [1, 0, 0, 2]);"},{"DocComment":" assert!(matches!("},{"DocComment":"     result,"},{"DocComment":"     StepResult::Undetermined {"},{"DocComment":"         active: [true, false, false, true]"},{"DocComment":"     }"},{"DocComment":" ));"},{"DocComment":" ```"},{"DocComment":""},{"DocComment":" Implementation note: dispatch on the active pattern is a `match` on the"},{"DocComment":" `(bool, bool, bool, bool)` tuple of `active`, not an `&&`-chained"},{"DocComment":" `if`/`else if` ladder — see the note on [`triple_step`]."}],"inline":null,"rename":null,"public":true},"is_local":true,"opacity":"Transparent","lang_item":null},"generics":{"regions":[],"types":[],"const_generics":[],"trait_clauses":[],"regions_outlive":[],"types_outlive":[],"trait_type_constraints":[]},"signature":{"is_unsafe":false,"abi":"Rust","is_variadic":false,"inputs":[{"Deduplicated":369},{"Deduplicated":507}],"output":{"Deduplicated":388}},"src":"TopLevel","is_global_initializer":null,"body":{"Structured":{"span":{"data":{"file_id":0,"beg":{"line":336,"col":0},"end":{"line":371,"col":1}},"generated_from_span":null},"bound_body_regions":0,"locals":{"arg_count":2,"locals":[{"index":0,"name":null,"span":{"data":{"file_id":0,"beg":{"line":336,"col":52},"end":{"line":336,"col":62}},"generated_from_span":null},"ty":{"Deduplicated":388}},{"index":1,"name":"active","span":{"data":{"file_id":0,"beg":{"line":336,"col":12},"end":{"line":336,"col":18}},"generated_from_span":null},"ty":{"Deduplicated":369}},{"index":2,"name":"words","span":{"data":{"file_id":0,"beg":{"line":336,"col":31},"end":{"line":336,"col":36}},"generated_from_span":null},"ty":{"Deduplicated":507}},{"index":3,"name":"a0","span":{"data":{"file_id":0,"beg":{"line":337,"col":8},"end":{"line":337,"col":10}},"generated_from_span":null},"ty":{"Deduplicated":367}},{"index":4,"name":null,"span":{"data":{"file_id":0,"beg":{"line":337,"col":20},"end":{"line":337,"col":21}},"generated_from_span":null},"ty":{"Deduplicated":368}},{"index":5,"name":"a1","span":{"data":{"file_id":0,"beg":{"line":338,"col":8},"end":{"line":338,"col":10}},"generated_from_span":null},"ty":{"Deduplicated":367}},{"index":6,"name":null,"span":{"data":{"file_id":0,"beg":{"line":338,"col":20},"end":{"line":338,"col":21}},"generated_from_span":null},"ty":{"Deduplicated":368}},{"index":7,"name":"a2","span":{"data":{"file_id":0,"beg":{"line":339,"col":8},"end":{"line":339,"col":10}},"generated_from_span":null},"ty":{"D